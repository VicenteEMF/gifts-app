# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- Environment variables ----------
# Never commit real secrets. Commit .env.example instead.
.env
.env.*
!.env.example

# ---------- Build output ----------
dist/
build/
out/
*.tsbuildinfo

# ---------- Next.js ----------
.next/
next-env.d.ts

# ---------- Expo / React Native ----------
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ---------- Native builds (only if you eject or prebuild) ----------
# Remove these two lines if you decide to commit native projects.
/apps/mobile/android/
/apps/mobile/ios/

# ---------- Monorepo tooling caches ----------
.turbo/
.nx/cache

# ---------- Testing / coverage ----------
coverage/
.nyc_output/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editors & OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------- Misc ----------
*.pem
.cache/
tmp/
temp/
